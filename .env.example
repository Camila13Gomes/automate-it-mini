# Copy this file to .env and replace every example value before starting Docker.
POSTGRES_DB=automateit
POSTGRES_USER=automateit
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Backend database connection. DB_PASSWORD must match POSTGRES_PASSWORD.
DB_URL=jdbc:postgresql://localhost:5432/automateit
DB_USERNAME=automateit
DB_PASSWORD=replace-with-the-same-long-random-password

# Required only when the first administrator is created.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-administrator-password
ADMIN_DISPLAY_NAME=Administrator
